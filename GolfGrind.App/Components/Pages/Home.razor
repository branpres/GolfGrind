@page "/"
@implements IDisposable
@inject GolferProfileService ProfileService
@inject GolfBagService BagService
@inject SessionStorageService SessionStorage
@inject ActivitySessionCoordinator ActivitySessions
@inject BackupService BackupService
@inject PracticeGameEngine PracticeGameEngine
@inject LaunchMonitorWorkspace MonitorWorkspace

<PageTitle>Golf Grind</PageTitle>

<AppToolbar Status="status"
            Clubs="clubs"
            SelectedClubId="selectedClubId"
            SelectedClubIdChanged="SetClubAsync"
            ActiveView="@activeView"
            ModeLabel="@ActiveModeLabel"
            MonitorMode="@monitorMode"
            BagGuideActive="bagGuide.IsActive"
            IsConnected="ActiveMonitor.IsConnected"
            MockConnected="MockMonitor.IsConnected"
            AudibleReadyNotification="audibleReadyNotification"
            MenuOpen="appMenuOpen"
            MenuRequested="ToggleAppMenu"
            ToggleConnection="ToggleConnectionAsync"
            SimulateShot="SimulateShot" />

@if (appMenuOpen)
{
    <AppNavigation ActiveView="@activeView"
                   ViewSelected="SelectViewAsync"
                   CloseRequested="CloseAppMenu"
                   SettingsRequested="OpenAppSettings" />
}

@if (appSettingsOpen)
{
    <AppSettingsPanel Profiles="profiles"
                      SelectedProfileId="selectedProfileId"
                      SelectedProfileIdChanged="SetProfileAsync"
                      MonitorMode="@monitorMode"
                      MonitorModeChanged="SetMonitorModeAsync"
                      ProfileChangeDisabled="ProfileChangeDisabled"
                      IsConnected="ActiveMonitor.IsConnected"
                      KeepScreenAwake="keepScreenAwake"
                      KeepScreenAwakeChanged="SetKeepScreenAwake"
                      AudibleReadyNotification="audibleReadyNotification"
                      AudibleReadyNotificationChanged="SetAudibleReadyNotification"
                      NewSession="StartNewSession"
                      CloseRequested="CloseAppSettings" />
}

@if (rejectedShotCount > 0 || duplicateShotCount > 0 || !string.IsNullOrWhiteSpace(shotDiagnosticMessage))
{
    <section class="reliability-strip" aria-label="Launch monitor reliability status">
        <span><strong>@status.ConnectionState</strong> · @status.Message</span>
        <span>Accepted @acceptedShotCount · Rejected @rejectedShotCount · Duplicates @duplicateShotCount</span>
        @if (!string.IsNullOrWhiteSpace(shotDiagnosticMessage))
        {
            <span>@shotDiagnosticMessage</span>
        }
    </section>
}

@if (activeView == "Golfers")
{
    <GolfersPanel Profiles="profiles"
                  ActiveProfileId="selectedProfileId"
                  PendingDeleteProfileId="pendingDeleteProfileId"
                  ChangeDisabled="ProfileChangeDisabled"
                  Message="@profileMessage"
                  SaveNames="SaveProfileNames"
                  UseProfile="UseProfileAsync"
                  DeleteProfile="RequestDeleteProfileAsync"
                  AddProfile="AddProfileFromPanelAsync" />
}

@if (activeView == "Golf Bag")
{
    <GolfBagPanel Clubs="clubs"
                  Message="@bagMessage"
                  SaveBag="SaveBagAsync"
                  RemoveClub="RemoveClub"
                  AddClubRequested="AddClubFromPanel" />
}

@if (activeView == "Bag Mapping")
{
    <BagMappingPanel LastShot="lastShot"
                     Clubs="clubs"
                     SelectedClubIds="bagGuide.SelectedClubIds"
                     Statistics="BagStatistics"
                     DispersionShots="DispersionShots"
                     GuideActive="bagGuide.IsActive"
                     ShotsPerClub="bagGuide.ShotsPerClub"
                     ShotsPerClubChanged="SetBagGuideShotsPerClub"
                     ShotInClub="bagGuide.ShotInClub"
                     GuidePrompt="@BagGuidePrompt"
                     Message="@BagGuideMessage"
                     SuggestedDistanceYards="suggestedDistanceYards"
                     SuggestedDistanceYardsChanged="SetSuggestedDistance"
                     SuggestedClub="@SuggestedClub"
                     AnalyticsClubId="analyticsClubId"
                     AnalyticsClubIdChanged="SetAnalyticsClub"
                     SelectedAnalyticsStockCarry="SelectedAnalyticsStockCarry"
                     GapToNext="GapToNext"
                     GapClass="GapClass"
                     SelectAll="SelectAllBagGuideClubs"
                     DeselectAll="DeselectAllBagGuideClubs"
                     ToggleClub="ToggleBagGuideClub"
                     StartGuide="StartBagGuideAsync"
                     StopGuide="StopBagGuide"
                     ApplyCalculatedCarries="ApplyCalculatedCarries" />
}

@if (activeView == "Wedge Matrix")
{
    <WedgeMatrixPanel LastShot="lastShot"
                      Clubs="clubs"
                      Sessions="SessionStorage.GetSessions()"
                      SelectedClubIds="wedgeGuide.SelectedClubIds"
                      GuideActive="wedgeGuide.IsActive"
                      ShotsPerCell="wedgeGuide.ShotsPerCell"
                      ShotsPerCellChanged="SetWedgeGuideShotsPerCell"
                      ShotInCell="wedgeGuide.ShotInCell"
                      GuidePrompt="@WedgeGuidePrompt"
                      Message="@WedgeGuideMessage"
                      SelectAll="SelectAllWedgeGuideClubs"
                      DeselectAll="DeselectAllWedgeGuideClubs"
                      ToggleClub="ToggleWedgeGuideClub"
                      StartGuide="StartWedgeGuideAsync"
                      StopGuide="StopWedgeGuide" />
}

@if (activeView == "Practice")
{
    <PracticeGamesPanel LastShot="lastShot"
                        Clubs="clubs"
                        State="practiceGameState"
                        Options="CurrentPracticeOptions"
                        PersonalBest="PracticePersonalBest"
                        SelectGame="SelectPracticeGame"
                        StartGame="StartPracticeGame"
                        EndGame="EndPracticeGame" />
}

@if (activeView == "Analytics")
{
    <AnalyticsPanel Clubs="clubs" Sessions="SessionStorage.GetSessions()" GolferName="@ActiveProfileName" />
}

@if (activeView == "Sessions")
{
    <SessionsPanel GolferName="@ActiveProfileName"
                   Sessions="SessionStorage.GetSessions()"
                   CurrentSessionId="currentSession.Id"
                   ExpandedSessionId="selectedHistorySessionId"
                   PendingDeleteSessionId="pendingDeleteWholeSessionId"
                   PendingBackup="pendingBackup"
                   BackupMessage="@backupMessage"
                   ToastMessage="@sessionToast"
                   SessionTitle="SessionTitle"
                   SessionType="SessionType"
                   SessionDate="SessionDate"
                   SessionClubs="SessionClubs"
                   AverageCarry="AverageCarry"
                   DeleteImpact="DeleteImpact"
                   IsPotentialOutlier="IsPotentialOutlier"
                   IsDeletePending="IsDeletePending"
                   ExportBackup="ExportBackup"
                   ExportCsv="ExportCsv"
                   ImportBackup="ChooseBackupAsync"
                   ConfirmImport="ConfirmBackupImport"
                   CancelImport="CancelBackupImport"
                   ToggleDetails="ToggleSessionDetails"
                   ExportSession="ExportSessionAsync"
                   DeleteSession="RequestDeleteSession"
                   RenameSession="RenameSession"
                   ToggleExclusion="HandleToggleExclusion"
                   DeleteShot="HandleDeleteShot" />
}

@if (activeView == "Range")
{
    <RangePanel MonitorMode="@monitorMode"
                DiagnosticsPath="@ActiveMonitor.DiagnosticsPath"
                LastShot="lastShot"
                Session="currentSession"
                IsPotentialOutlier="IsPotentialOutlier"
                IsDeletePending="IsDeletePending"
                ToggleExclusion="HandleToggleExclusion"
                DeleteShot="HandleDeleteShot" />
}
