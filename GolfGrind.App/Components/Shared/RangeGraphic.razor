@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="card tracer-card live-range-card">
    <div class="section-heading">
        <div>
            <h2>Shot tracer</h2>
            <span class="muted">Calculated flight · standard conditions · no wind</span>
        </div>
        @if (LastShot is not null)
        {
            <strong>@ShotHeading(LastShot)</strong>
        }
    </div>
    <div class="tracer-view-tabs" role="group" aria-label="Shot tracer view">
        <button type="button" class="@(tracerView == TracerView.Perspective ? "active" : null)" aria-pressed="@(tracerView == TracerView.Perspective)" @onclick="() => SetTracerViewAsync(TracerView.Perspective)">Perspective</button>
        <button type="button" class="@(tracerView == TracerView.Side ? "active" : null)" aria-pressed="@(tracerView == TracerView.Side)" @onclick="() => SetTracerViewAsync(TracerView.Side)">Side</button>
    </div>
    @if (tracerView == TracerView.Perspective)
    {
    <svg @ref="tracerSvg" class="tracer perspective-tracer" viewBox="0 0 600 450" role="img" aria-label="Perspective shot tracer">
        <defs>
            <linearGradient id="range-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#071426" />
                <stop offset="100%" stop-color="#234a5d" />
            </linearGradient>
            <linearGradient id="range-ground" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#173821" />
                <stop offset="100%" stop-color="#08170e" />
            </linearGradient>
            <linearGradient id="range-fairway" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#285d32" />
                <stop offset="100%" stop-color="#174322" />
            </linearGradient>
            <filter id="tracer-glow" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="2.5" result="blur" />
                <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="ball-glow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
        </defs>
        <rect x="0" y="0" width="600" height="450" rx="12" class="range-sky" />
        <path d="M 0 24 L 600 24 L 600 450 L 0 450 Z" class="range-ground" />
        <path d="M 242 24 L 358 24 L 590 450 L 10 450 Z" class="range-fairway" />
        <path d="M 300 424 L 300 24" class="center-line" />
        <path d="M 10 450 L 242 24 M 590 450 L 358 24" class="range-edge" />
        @foreach (var marker in RangeMarkers)
        {
            var y = GroundY(marker);
            var halfWidth = GroundHalfWidth(marker);
            var left = 300 - halfWidth;
            var right = 300 + halfWidth;
            var markerClass = marker % 50 == 0 ? "major" : "minor";
            <line x1="@left" y1="@y" x2="@right" y2="@y" class="yard-line @markerClass" />
            @if (marker % 50 == 0)
            {
                <foreignObject x="267" y="@(y - 10)" width="66" height="20">
                    <div class="svg-yard-label perspective">@(marker + " yd")</div>
                </foreignObject>
            }
        }
        <ellipse cx="300" cy="426" rx="18" ry="5" class="tee-marker" />
        @if (LastShot is { FlightPath: { Count: > 1 } flightPath } shot)
        {
            var end = flightPath[^1];
            var endX = ProjectX(end);
            var endY = ProjectY(end);
            var tracerPath = TracerPath(flightPath);
            <g class="tracer-animation" @key="shot.HitAt">
                <path d="@tracerPath" class="shot-path animated-shot-path" />
                <circle cx="0" cy="0" r="5.5" class="shot-ball" opacity="0" />
                <circle cx="@endX" cy="@endY" r="8" class="shot-end animated-shot-end" opacity="0" />
            </g>
        }
        else if (LastShot is { } shotWithoutPath)
        {
            var endX = DirectionToX(shotWithoutPath.LaunchDirectionDeg);
            <path d="M 300 424 Q 300 165 @endX 112" class="shot-path" />
            <circle cx="@endX" cy="112" r="8" class="shot-end" />
            <text><tspan x="300" y="65" text-anchor="middle" class="yard-label">Flight distance not calculated yet</tspan></text>
        }
    </svg>
    }
    else
    {
        var sideMaxDistance = SideMaxDistance(LastShot);
        <svg @ref="tracerSvg" class="tracer side-tracer" viewBox="0 0 600 450" role="img" aria-label="Side view shot tracer">
            <defs>
                <linearGradient id="side-sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#071426" />
                    <stop offset="100%" stop-color="#234a5d" />
                </linearGradient>
                <linearGradient id="side-ground" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#173821" />
                    <stop offset="100%" stop-color="#08170e" />
                </linearGradient>
                <filter id="side-tracer-glow" x="-40%" y="-40%" width="180%" height="180%">
                    <feGaussianBlur stdDeviation="2.5" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <filter id="side-ball-glow" x="-100%" y="-100%" width="300%" height="300%">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
            </defs>
            <rect x="0" y="0" width="600" height="450" rx="12" class="side-sky" />
            <rect x="0" y="@SideGroundY" width="600" height="@(450 - SideGroundY)" class="side-ground" />
            <line x1="@SideLeft" y1="@SideGroundY" x2="@SideRight" y2="@SideGroundY" class="side-ground-line" />
            @foreach (var marker in SideRangeMarkers(sideMaxDistance))
            {
                var x = SideX(marker, sideMaxDistance);
                <line x1="@x" y1="42" x2="@x" y2="@SideGroundY" class="side-yard-line" />
                <foreignObject x="@(x - 34)" y="@(SideGroundY + 7)" width="68" height="20">
                    <div class="svg-yard-label side">@(marker + " yd")</div>
                </foreignObject>
            }
            <ellipse cx="@SideLeft" cy="@SideGroundY" rx="6" ry="3" class="tee-marker" />
            @if (LastShot is { FlightPath: { Count: > 1 } sideFlightPath } sideShot)
            {
                var sideEnd = sideFlightPath[^1];
                var sideEndX = SideX(sideEnd.DownRangeYards, sideMaxDistance);
                var sideEndY = SideY(sideEnd.HeightYards, sideMaxDistance);
                var sideTracerPath = SideTracerPath(sideFlightPath, sideMaxDistance);
                <g class="tracer-animation" @key="sideShot.HitAt">
                    <path d="@sideTracerPath" class="shot-path side-shot-path animated-shot-path" />
                    <circle cx="0" cy="0" r="5.5" class="shot-ball side-shot-ball" opacity="0" />
                    <circle cx="@sideEndX" cy="@sideEndY" r="8" class="shot-end animated-shot-end" opacity="0" />
                </g>
            }
            else if (LastShot is not null)
            {
                <path d="M @SideLeft @SideGroundY Q 300 90 @SideRight @SideGroundY" class="shot-path side-shot-path" />
                <circle cx="@SideRight" cy="@SideGroundY" r="8" class="shot-end" />
                <text><tspan x="300" y="65" text-anchor="middle" class="yard-label">Flight distance not calculated yet</tspan></text>
            }
        </svg>
    }
    @if (ShowSummary)
    {
        @if (LastShot is null)
        {
            <div class="compact-shot-empty">Last-shot measurements will appear here after the next shot.</div>
        }
        else
        {
            <div class="compact-shot-grid" aria-label="Last shot summary">
                @SummaryMetric("Carry", LastShot.CarryYards, "yd", help: GolfTerms.Carry)
                @SummaryMetric("Total", LastShot.TotalYards, "yd", help: GolfTerms.Total)
                @SummaryMetric("Offline", LastShot.OfflineYards, "yd", signed: true, help: GolfTerms.Offline)
                @SummaryMetric("Ball speed", LastShot.BallSpeedMph, "mph", help: GolfTerms.BallSpeed)
                @SummaryMetric("Launch", LastShot.LaunchAngleDeg, "°", help: GolfTerms.Launch)
                @SummaryMetric("Spin", LastShot.TotalSpinRpm ?? LastShot.BackSpinRpm, "rpm", decimals: 0, help: GolfTerms.TotalSpin)
            </div>
        }
    }
</section>

@code {
    [Parameter] public ShotData? LastShot { get; set; }
    [Parameter] public bool ShowSummary { get; set; } = true;

    private ElementReference tracerSvg;
    private DateTimeOffset? animatedShotAt;
    private TracerView tracerView = TracerView.Perspective;

    private static readonly int[] RangeMarkers = Enumerable.Range(1, 12).Select(index => index * 25).ToArray();
    private const double HorizonY = 24;
    private const double TeeY = 424;
    private const double SideLeft = 42;
    private const double SideRight = 574;
    private const double SideGroundY = 390;
    private static double GroundY(double downRangeYards) =>
        HorizonY + (TeeY - HorizonY) * Math.Exp(-Math.Max(0, downRangeYards) / 145d);
    private static double GroundHalfWidth(double downRangeYards) =>
        40 + 250 * ((GroundY(downRangeYards) - HorizonY) / (TeeY - HorizonY));
    private static double PerspectiveScale(double downRangeYards) => 620 / (Math.Max(0, downRangeYards) + 100);
    private static double ProjectX(FlightPoint point) =>
        Math.Clamp(300 + point.OfflineYards * PerspectiveScale(point.DownRangeYards), 12, 588);
    private static double ProjectY(FlightPoint point) =>
        Math.Clamp(GroundY(point.DownRangeYards) - point.HeightYards * PerspectiveScale(point.DownRangeYards), 16, TeeY);
    private static double DirectionToX(double degrees) => Math.Clamp(300 + degrees * 12, 40, 560);
    private static double AnimationDuration(ShotData shot) =>
        Math.Clamp((shot.FlightTimeSeconds ?? 3.5) * 0.4, 0.9, 2.5) * 1000;
    private static string ShotHeading(ShotData shot) =>
        ShotAnalytics.NormalizeSwing(shot.SwingType) == "Full"
            ? shot.Club
            : $"{shot.Club} · {SwingLabel(shot.SwingType)} swing";
    private static string SwingLabel(string? swingType) => ShotAnalytics.NormalizeSwing(swingType) switch
    {
        "Quarter" => "¼",
        "Half" => "½",
        "ThreeQuarter" => "¾",
        _ => "Full"
    };
    private static string TracerPath(IReadOnlyList<FlightPoint> points)
    {
        var commands = points.Select((point, index) =>
            $"{(index == 0 ? "M" : "L")} {ProjectX(point).ToString("0.0", CultureInfo.InvariantCulture)} {ProjectY(point).ToString("0.0", CultureInfo.InvariantCulture)}");
        return string.Join(" ", commands);
    }

    private static double SideMaxDistance(ShotData? shot)
    {
        var farthest = Math.Max(shot?.CarryYards ?? 0, shot?.TotalYards ?? 0);
        if (shot?.FlightPath is { Count: > 0 } path)
            farthest = Math.Max(farthest, path.Max(point => point.DownRangeYards));
        return Math.Max(300, Math.Ceiling(farthest / 50d) * 50d);
    }

    private static IEnumerable<int> SideRangeMarkers(double maxDistance) =>
        Enumerable.Range(1, (int)Math.Floor(maxDistance / 50d)).Select(index => index * 50);

    private static double SideX(double downRangeYards, double maxDistance) =>
        SideLeft + Math.Clamp(downRangeYards, 0, maxDistance) / maxDistance * (SideRight - SideLeft);

    private static double SideY(double heightYards, double maxDistance) =>
        Math.Max(42, SideGroundY - Math.Max(0, heightYards) / maxDistance * (SideRight - SideLeft));

    private static string SideTracerPath(IReadOnlyList<FlightPoint> points, double maxDistance)
    {
        var commands = points.Select((point, index) =>
            $"{(index == 0 ? "M" : "L")} {SideX(point.DownRangeYards, maxDistance).ToString("0.0", CultureInfo.InvariantCulture)} {SideY(point.HeightYards, maxDistance).ToString("0.0", CultureInfo.InvariantCulture)}");
        return string.Join(" ", commands);
    }

    private async Task SetTracerViewAsync(TracerView view)
    {
        if (tracerView == view)
            return;
        try
        {
            await JS.InvokeVoidAsync("golfTracer.cancel", tracerSvg);
        }
        catch (JSDisconnectedException)
        {
        }
        tracerView = view;
        animatedShotAt = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (LastShot is not { FlightPath: { Count: > 1 } } shot || animatedShotAt == shot.HitAt)
            return;
        animatedShotAt = shot.HitAt;
        await JS.InvokeVoidAsync("golfTracer.animate", tracerSvg, AnimationDuration(shot));
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("golfTracer.cancel", tracerSvg);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static RenderFragment SummaryMetric(string label, double? value, string unit, int decimals = 1, bool signed = false, string? help = null) => builder =>
    {
        var format = decimals == 0 ? "0" : "0." + new string('0', decimals);
        var formatted = value is null
            ? "—"
            : signed
                ? value.Value.ToString($"+{format};-{format};{format}", CultureInfo.InvariantCulture)
                : value.Value.ToString(format, CultureInfo.InvariantCulture);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "compact-shot-metric");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", "term-help");
        builder.AddAttribute(4, "tabindex", "0");
        builder.AddAttribute(5, "data-tooltip", help);
        builder.AddAttribute(6, "aria-label", $"{label}: {help}");
        builder.AddContent(7, label);
        builder.CloseElement();
        builder.OpenElement(8, "strong");
        builder.AddContent(9, formatted);
        builder.OpenElement(10, "small");
        builder.AddContent(11, unit);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private enum TracerView
    {
        Perspective,
        Side
    }
}
